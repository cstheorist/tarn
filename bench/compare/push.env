# What a push to bench/compare runs: bench/compare/run.sh's configurations
# and environment (see its header). A manual run's inputs override CONFIGS
# and TIME.
#
# Issue #23, step 7: vinyl tables with a cache larger than the data and with
# data ten times the cache, against memtx and TiDB, at 4 x 1,000,000 rows.
CONFIGS="tarn_2x1 tarn_2x1_vinyl tarn_2x1_vinyl_10x tidb_rf1 tidb_rf1_10x"
TABLES=4
SIZE=1000000
TIME=30
THREADS="1 16 64"
PERCENTILE=99
WARM=1
TESTS="oltp_point_select oltp_read_only oltp_update_index oltp_update_non_index oltp_insert oltp_read_write"
