# Pinned versions of a benchmark run. build-bundle.sh builds the first group
# into the bundle; the control node downloads the second at run time and
# checks it (tiup verifies its mirror's signatures; YugabyteDB's tarball is
# checked against the vendor's published SHA-256).

TARANTOOL_VERSION=3.9.0
SYSBENCH_REF=1.0.20
# YugabyteDB's sysbench fork (multiple hosts for --pgsql-host, YSQL-aware
# prepare); a commit, since the fork has no release tags.
SYSBENCH_YB_REF=15be8ade61195fc371b1309bed2aaa2d1c9a0e40
# Runtime libraries of the two sysbench builds (worker VMs have no internet).
RUNTIME_DEBS="libmysqlclient21 mysql-common libpq5"

TIDB_VERSION=v8.5.8
YB_VERSION=2026.1.3.0
YB_BUILD=b100
YB_URL=https://software.yugabyte.com/releases/2026.1.3.0/yugabyte-2026.1.3.0-b100-linux-x86_64.tar.gz
YB_SHA_URL=https://software.yugabyte.com/releases/2026.1.3.0/yugabyte-2026.1.3.0-b100-linux-x86_64-tar.gz.sha
